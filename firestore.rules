rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Somente para uma demonstração escolar temporária SEM dados pessoais.
    // ATENÇÃO: acesso público significa que qualquer visitante pode ler,
    // editar ou excluir os destinos. Não utilize essas regras em produção.
    match /destinos/{destinoId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['city','country','status','date','image','notes','budget','latitude','longitude','createdAt','updatedAt'])
        && request.resource.data.city is string
        && request.resource.data.city.size() > 0 && request.resource.data.city.size() <= 90
        && request.resource.data.country is string
        && request.resource.data.country.size() > 0 && request.resource.data.country.size() <= 90
        && request.resource.data.status in ['wishlist','planning','visited'];
      allow update: if request.resource.data.keys().hasOnly(['city','country','status','date','image','notes','budget','latitude','longitude','createdAt','updatedAt'])
        && request.resource.data.city is string
        && request.resource.data.city.size() > 0 && request.resource.data.city.size() <= 90
        && request.resource.data.country is string
        && request.resource.data.country.size() > 0 && request.resource.data.country.size() <= 90
        && request.resource.data.status in ['wishlist','planning','visited'];
      allow delete: if true;
    }
  }
}
